    <string name="privacy_clean_note">Removes the tracking parts of web addresses.</string>
    <string name="privacy_previews">Generate link previews</string>
    <string name="privacy_previews_note">When a network sends no preview, PingMe fetches the page itself, which shows the website your phone\'s internet address.</string>
