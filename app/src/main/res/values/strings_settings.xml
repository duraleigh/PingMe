    <string name="privacy_read_receipts">Send read receipts</string>
    <string name="privacy_read_receipts_note">Off: PingMe never tells the network you read a message. The chat then also stays unread in that network\'s own app, because it is the same signal.</string>
    <string name="privacy_typing">Show when I am typing</string>
    <string name="privacy_typing_note">Off: nobody sees you typing. What you see of others does not change.</string>
